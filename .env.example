# Database Configuration
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/nestjs_auth_kit?schema=public"

# Direct database connection (required by some Prisma features and providers like Neon)
DIRECT_URL="postgresql://user:password@localhost:5432/nestjs_auth_kit?schema=public"

# JWT Configuration
# IMPORTANT: Generate a strong random secret for production
# Example: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production"

# Server Configuration
PORT=3000
